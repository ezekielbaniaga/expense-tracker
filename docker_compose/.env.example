POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb

ADMIN_USERNAME=admin
# The app refuses to start while this is still change-me. Used only to create the admin on the first
# start (at least 12 characters then); changing it later does not change an existing admin's password.
ADMIN_PASSWORD=change-me

# At least 256 bits (32 bytes) for HS256, e.g. `openssl rand -base64 32`
JWT_SECRET=change-me

# Regex of the reverse proxy's IP(s). Only these may set X-Forwarded-For (the client IP stored with
# each session). This is the web service's fixed address in docker-compose.yml; never the whole subnet.
# Leave empty when no proxy is in front.
TRUSTED_PROXIES=172[.]28[.]0[.]10
