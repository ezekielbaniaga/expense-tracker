POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# At least 256 bits (32 bytes) for HS256, e.g. `openssl rand -base64 32`
JWT_SECRET=change-me

# Regex of the reverse proxy's IP(s), e.g. 172[.]18[.]0[.]10. Only these may set X-Forwarded-For
# (the client IP stored with each session). Leave empty while there is no proxy in front.
TRUSTED_PROXIES=
